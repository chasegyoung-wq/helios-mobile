{
  "expo": {
    "name": "Helios",
    "slug": "helios-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0F1C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.helios.member",
      "infoPlist": {
        "NSCameraUsageDescription": "Used for scanning QR codes and profile photos",
        "NSFaceIDUsageDescription": "Used for biometric login"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0F1C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.helios.member"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B8944F"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Helios to use Face ID for secure login"
        }
      ]
    ],
    "scheme": "helios"
  }
}
